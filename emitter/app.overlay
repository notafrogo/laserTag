/ {
    aliases {
        ir-pwm = &pwm0;
        trigger-button = &trigger_button;
    };

    gpio_keys {
        compatible = "gpio-keys";
        trigger_button: trigger_button {
            /* Trigger switch is on P0.29, normally-closed, wired between
             * pin and GND. With the NC closed at idle, the switch shorts
             * the pin to GND (overrides the internal pull-up). Pressing
             * the trigger opens the NC contact, the pull-up takes the
             * pin HIGH, which reads as "active" per GPIO_ACTIVE_HIGH.
             *
             * Symptom that pinpointed this wiring: with ACTIVE_HIGH +
             * PULL_DOWN, no fires happen because pressing doesn't pull
             * the pin HIGH (NC opens, but pull-down still wins). With
             * ACTIVE_LOW + PULL_UP, fires happen at idle because the
             * NC short reads as "active". The combo here is the only
             * one that lines up.
             *
             * The 20 ms ISR debounce in trigger_pressed_cb handles the
             * release-bounce that previously caused double-fires under
             * this same polarity + pull combo.
             */
            gpios = <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
            label = "Trigger Button";
        };
    };
};

/*
 * Disable uart0 to free up its pins (like P0.20) for other uses.
 * This is safe because we are using the USB serial backend for logs.
 */
&uart0 {
    status = "disabled";
};

&pwm0 {
    status = "okay";
    pinctrl-0 = <&pwm0_default>;
    pinctrl-1 = <&pwm_sleep>;
    pinctrl-names = "default", "sleep";
};

&pinctrl {
    pwm0_default: pwm0_default {
        group1 {
            /* IR LED on P1.04. H0H1 high drive (~5 mA, vs ~0.5 mA standard)
             * so the pin can source enough current for a direct-driven IR LED
             * or hard-saturate the switching transistor.
             */
            psels = <NRF_PSEL(PWM_OUT0, 1, 4)>;
            nordic,drive-mode = <NRF_DRIVE_H0H1>;
        };
    };

    pwm_sleep: pwm_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 1, 4)>;
            low-power-enable;
        };
    };
};