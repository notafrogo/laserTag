/ {
    aliases {
        irsensor = &ir_rx_pin;
    };

    gpio_inputs {
        compatible = "gpio-keys";
        ir_rx_pin: ir_rx_pin {
            /* VS1838B output is on P0.29 */
            gpios = <&gpio0 29 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "VS1838B IR Receiver";
        };
    };
};

/* Pro Micro nRF52840: its board file has pwm0 enabled and bound to P0.15
 * (the onboard red LED) via the red_pwm_led pwm-leds node. Don't let the
 * board's PWM peripheral keep that pin in play — we drive it as plain GPIO
 * for the status LED, and a contention between pwm0's pinctrl claim and
 * our GPIO output on the same pad has been observed pulling the supply
 * rail down gradually. Disabling pwm0 here is harmless on the receiver
 * (we don't transmit IR here) and releases P0.15 to be pure GPIO.
 */
&pwm0 {
    status = "disabled";
};